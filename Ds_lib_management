DELIMITER //

CREATE PROCEDURE MemberHistory(IN mid INT)
BEGIN
    SELECT *
    FROM issues
    WHERE member_id = mid;
END //

DELIMITER ;

CALL MemberHistory(1);


-- C14

DELIMITER //

CREATE TRIGGER reduce_copies
AFTER INSERT ON issues
FOR EACH ROW
BEGIN
    UPDATE books
    SET available_copies = available_copies - 1
    WHERE book_id = NEW.book_id;
END //

DELIMITER ;


