-- C3

SELECT category, COUNT(*) AS total_titles,
SUM(available_copies) AS available_copies
FROM books
GROUP BY category;


-- C4

SELECT b.title, COUNT(*) AS borrow_count
FROM issues i
JOIN books b ON i.book_id = b.book_id
GROUP BY b.book_id, b.title
ORDER BY borrow_count DESC
LIMIT 5;


-- C5

SELECT m.member_name
FROM members m
LEFT JOIN issues i ON m.member_id = i.member_id
WHERE i.member_id IS NULL;


-- C6

SELECT m.member_name, b.title, i.due_date
FROM issues i
JOIN members m ON i.member_id = m.member_id
JOIN books b ON i.book_id = b.book_id
WHERE i.return_date IS NULL;


-- C7

SELECT issue_id, member_id, book_id,
DATEDIFF(return_date, due_date) AS late_days,
DATEDIFF(return_date, due_date) * 5 AS fine
FROM issues
WHERE return_date > due_date;


-- C8

SELECT member_id, SUM(fine) AS total_fine
FROM issues
GROUP BY member_id;


-- C9

SELECT m.member_type, COUNT(*) AS total_borrowed
FROM members m
JOIN issues i ON m.member_id = i.member_id
GROUP BY m.member_type;


-- C10

SELECT m.member_name,
COUNT(i.issue_id) AS total_books,
RANK() OVER (ORDER BY COUNT(i.issue_id) DESC) AS member_rank
FROM members m
LEFT JOIN issues i ON m.member_id = i.member_id
GROUP BY m.member_id, m.member_name;


-- C11

SELECT b.category, COUNT(*) AS total_borrowed
FROM books b
JOIN issues i ON b.book_id = i.book_id
GROUP BY b.category
ORDER BY total_borrowed DESC
LIMIT 1;


-- C12

SELECT DISTINCT b.title, b.available_copies
FROM books b
JOIN issues i ON b.book_id = i.book_id
WHERE b.available_copies = 0
AND i.return_date IS NULL;


